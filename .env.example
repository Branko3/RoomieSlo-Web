NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Playwright staging smoke configuration. Never use a service-role key.
E2E_BASE_URL=http://127.0.0.1:3000
E2E_LISTING_ID=
E2E_AUTH_STATE=

# Optional Supabase integration suite (`npm run test:integration`), for a disposable or
# staging project only. Use the anon key (a service-role key is refused) and two
# ordinary test accounts; the admin account is optional.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
SUPABASE_TEST_ADMIN_EMAIL=
SUPABASE_TEST_ADMIN_PASSWORD=
