# Copy to .env.local for local development. Never commit populated .env files.
# ROOMIESLO_ENV is deployment-managed and must be development, staging, or production.
ROOMIESLO_ENV=development

# Public browser configuration (development, staging, and production).
# These are the only Supabase values permitted in a browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Playwright values are local or staging-only. E2E_AUTH_STATE must be a path to
# disposable staging browser state and must never contain a service-role key.
E2E_BASE_URL=http://127.0.0.1:3000
E2E_LISTING_ID=
E2E_AUTH_STATE=

# Operator-managed, never browser-exposed:
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# SUPABASE_SERVICE_ROLE_KEY=
