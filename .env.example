# Copy to .env.local for local development. Never commit populated .env files.
# ROOMIESLO_ENV is deployment-managed and must be development, staging, or production.
ROOMIESLO_ENV=development

# Public browser configuration (development, staging, and production).
# These are the only Supabase values permitted in a browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Playwright values are local or staging-only. E2E_AUTH_STATE must be a path to
# disposable staging browser state and must never contain a service-role key.
E2E_BASE_URL=http://127.0.0.1:3000
E2E_LISTING_ID=
E2E_AUTH_STATE=

# Data controller's contact e-mail (Branko), shown on /privacy and the delete-account
# page for deletion and correction requests and for reporting unfair roommate ratings.
# Must be set before ratings go live; while empty, the pages say it isn't set yet.
NEXT_PUBLIC_PRIVACY_CONTACT=

# Optional Supabase integration suite (`npm run test:integration`), for a disposable or
# staging project only. Use the anon key (a service-role key is refused) and two
# ordinary test accounts; the admin account is optional.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
SUPABASE_TEST_ADMIN_EMAIL=
SUPABASE_TEST_ADMIN_PASSWORD=

# Operator-managed, never browser-exposed:
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# SUPABASE_SERVICE_ROLE_KEY=
